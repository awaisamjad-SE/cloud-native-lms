          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.access) { pm.collectionVariables.set('access_token', json.access); } else if (json && json.access_token) { pm.collectionVariables.set('access_token', json.access_token); }",
                  "if (json && json.user) {",
                  "  pm.collectionVariables.set('user_role', json.user.role || '');",
                  "  pm.collectionVariables.set('user_id', json.user.id || '');",
                  "  pm.collectionVariables.set('user_email', json.user.email || '');",
                  "  pm.collectionVariables.set('user_phone', json.user.phone_number || '');",
                  "  pm.collectionVariables.set('user_profile_image', json.user.profile_image || '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
